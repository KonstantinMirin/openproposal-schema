{
  "$id": "https://openproposal.noetis.dev/schemas/with-our-stack/documents/1/package-summary.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The OpenProposal `PackageSummary` document.",
  "properties": {
    "add_ons": {
      "description": "Its `add_ons[]`, each as a summary. In a manifest entry, only those § 2.3 lists",
      "items": {
        "$ref": "line-item-summary.json"
      },
      "type": "array"
    },
    "line_items": {
      "description": "Its `line_items[]`, each as a summary",
      "items": {
        "$ref": "line-item-summary.json"
      },
      "type": "array"
    },
    "min_commitments": {
      "description": "Its `min_commitments[]`",
      "items": {
        "$ref": "../../modules/proposal/1/proposal.json#/$defs/MinCommitment"
      },
      "type": "array"
    },
    "package_id": {
      "$ref": "../../kernel/1/kernel.json#/$defs/PlainString",
      "description": "The package's `package_id` (§ 4.1.4)"
    }
  },
  "required": [
    "line_items",
    "package_id"
  ],
  "title": "PackageSummary",
  "type": "object"
}
