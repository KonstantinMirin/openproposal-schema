{
  "$defs": {
    "Amount": {
      "description": "A sum of money or a rate, as a Number that the canonical JSON serialization reproduces as written, with at most 15 significant digits inside the range of a double. It carries no currency; the entry it belongs to says which one it reads in.",
      "type": "number"
    },
    "App": {
      "additionalProperties": false,
      "properties": {
        "bundle": {
          "description": "Store ID. As OpenRTB 2.6 `app.bundle`",
          "type": "string"
        },
        "developer_domain": {
          "$ref": "#/$defs/Domain",
          "description": "Developer domain, informative; the governing developer domain comes from the store listing. No OpenRTB equivalent: not `app.domain`, which is the domain of the app"
        },
        "store": {
          "$ref": "#/$defs/AppIdStore",
          "description": "The app store that issued `bundle`. Core terms: `apple_app_store` | `google_play` | `roku_channel_store` | `amazon_appstore` | `samsung_apps_tv`. A `bundle` is unique only within its store. No OpenRTB equivalent"
        },
        "store_url": {
          "$ref": "#/$defs/Url",
          "description": "Store listing URL. As OpenRTB 2.6 `app.storeurl`"
        }
      },
      "required": [
        "bundle",
        "store"
      ],
      "type": "object"
    },
    "AppId": {
      "additionalProperties": false,
      "properties": {
        "bundle": {
          "description": "Store ID. As OpenRTB 2.6 `app.bundle`",
          "type": "string"
        },
        "store": {
          "$ref": "#/$defs/AppIdStore",
          "description": "The app store that issued `bundle`. Core terms: `apple_app_store` | `google_play` | `roku_channel_store` | `amazon_appstore` | `samsung_apps_tv`. A `bundle` is unique only within its store. No OpenRTB equivalent"
        }
      },
      "required": [
        "bundle",
        "store"
      ],
      "type": "object"
    },
    "AppIdStore": {
      "anyOf": [
        {
          "enum": [
            "apple_app_store",
            "google_play",
            "roku_channel_store",
            "amazon_appstore",
            "samsung_apps_tv"
          ],
          "type": "string"
        },
        {
          "$ref": "#/$defs/NamespacedTerm"
        }
      ]
    },
    "ApprovalStatus": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED"
      ],
      "type": "string"
    },
    "CalendarUnit": {
      "enum": [
        "hour",
        "day",
        "week",
        "month"
      ],
      "type": "string"
    },
    "ClockWindow": {
      "additionalProperties": false,
      "description": "A repeating window of civil time, on the days `days[]` names, from the first minute `start` up to `before`, the first minute after it, read on the line item's clock. It is deliberately not an interval between two points in time.",
      "properties": {
        "before": {
          "$ref": "#/$defs/TimeOfDay",
          "description": "The first minute after the window."
        },
        "days": {
          "description": "The days the window repeats on.",
          "items": {
            "$ref": "#/$defs/DayName"
          },
          "type": "array"
        },
        "start": {
          "$ref": "#/$defs/TimeOfDay",
          "description": "The first minute. Not `24:00`."
        }
      },
      "required": [
        "days",
        "start",
        "before"
      ],
      "type": "object"
    },
    "CommitmentAmountBasis": {
      "enum": [
        "spend",
        "units"
      ],
      "type": "string"
    },
    "CurrencyCode": {
      "description": "An ISO 4217 alphabetic currency code, such as `USD`.",
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "DayName": {
      "description": "A day of the week, named in lowercase English, from `monday` to `sunday`.",
      "enum": [
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday",
        "saturday",
        "sunday"
      ],
      "type": "string"
    },
    "Delta": {
      "additionalProperties": false,
      "description": "The price of one option outside `included[]`, as any of a change to the rate of a CPM or CPMV entry, a fraction that multiplies the rate of any entry, and a charge outside the rate. At least one is present.",
      "minProperties": 1,
      "properties": {
        "delta_cpm": {
          "$ref": "#/$defs/Amount",
          "description": "Added to the rate of a `CPM` or `CPMV` entry, and to no other."
        },
        "delta_flat": {
          "$ref": "#/$defs/Amount",
          "description": "A charge on any entry, outside the rate."
        },
        "delta_fraction": {
          "$ref": "#/$defs/FractionDelta",
          "description": "Multiplies the rate of any entry by 1 plus this value."
        }
      },
      "type": "object"
    },
    "Digest": {
      "description": "A SHA-256 hash, written with its algorithm as `sha256:` and the 64 lowercase hexadecimal characters of the hash, 71 characters in all. The field that holds it says what its input is.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "DocumentRef": {
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest",
          "description": "Over the exact bytes served, with no content coding"
        },
        "url": {
          "$ref": "#/$defs/HttpsUrl",
          "description": "The document. It MAY need authentication"
        }
      },
      "required": [
        "digest",
        "url"
      ],
      "type": "object"
    },
    "Domain": {
      "description": "A domain name in lowercase ASCII, its internationalized labels in A-label form, with no scheme, port, path, or trailing dot, such as `examplepub.example`. Two values are compared byte for byte.",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$",
      "type": "string"
    },
    "Duration": {
      "description": "A length of time, written in the ISO 8601 grammar of RFC 3339 Appendix A without its week form, such as `P14D` or `PT48H`, never `P2W`.",
      "format": "duration",
      "pattern": "^[0-9PYMDTHS]+$",
      "type": "string"
    },
    "EntryRef": {
      "description": "A named entry at one exact version, written `<domain>/<collection>/<entry_id>@<version>`, with no `/` or `@` inside a part, such as `examplepub.example/formats/homepage-takeover@3`. Its content doesn't change.",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*/[^\\x00-\\x20\\x7f/@]+/[^\\x00-\\x20\\x7f/@]+@[^\\x00-\\x20\\x7f/@]+$",
      "type": "string"
    },
    "ErrorObject": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorObjectCode",
          "description": "A core code (below) or an extension code"
        },
        "detail": {
          "description": "Human-readable. A receiver SHOULD NOT parse it",
          "type": "string"
        },
        "pointer": {
          "$ref": "#/$defs/FieldPointer",
          "description": "Into the object this specification defines that the request carries, to the value that caused the error"
        },
        "retry": {
          "$ref": "#/$defs/ErrorObjectRetry",
          "description": "`same` | `refetch` | `none`. `same`: the same request can succeed later. `refetch`: a new attempt, composed on the current `version`, can succeed. `none`: only a changed request can succeed. On a `commit`, `same` keeps the `idempotency_key` and such an error is not a stored result (§ 5.6.1), and `refetch` and `none` take a new `idempotency_key`"
        },
        "version": {
          "$ref": "#/$defs/SafeInteger",
          "description": "The proposal's `version` when the error was decided"
        }
      },
      "required": [
        "code",
        "detail",
        "retry"
      ],
      "type": "object"
    },
    "ErrorObjectCode": {
      "anyOf": [
        {
          "enum": [
            "validation",
            "not_found",
            "not_offered",
            "unresolved_reference",
            "not_committable",
            "stale_version",
            "expired",
            "idempotency_conflict",
            "not_eligible",
            "record_mismatch"
          ],
          "type": "string"
        },
        {
          "$ref": "#/$defs/NamespacedTerm"
        }
      ]
    },
    "ErrorObjectRetry": {
      "enum": [
        "same",
        "refetch",
        "none"
      ],
      "type": "string"
    },
    "FieldPointer": {
      "description": "A location in an object of the specification, written as a JSON Pointer, such as `/line_items/0/pricing/1/list_rate`.",
      "pattern": "^(/([^\\x00-\\x1f~/]|~[01])*)*$",
      "type": "string"
    },
    "FormatId": {
      "description": "The ID of a creative format, written `<channel>/<name>`, where `<channel>` is the line item's channel, with no `/` or `@` inside a part, such as `display/300x250`.",
      "pattern": "^[^\\x00-\\x20\\x7f/@]+/[^\\x00-\\x20\\x7f/@]+$",
      "type": "string"
    },
    "Fraction": {
      "description": "A proportion from 0 to 1, such as 0.7 for 70 %.",
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "FractionDelta": {
      "description": "A change to a rate as a fraction of it, a Number greater than -1, such as `0.20` for 20 percent more.",
      "exclusiveMinimum": -1,
      "type": "number"
    },
    "GeoCode": {
      "description": "An area, written as an ISO 3166-1 alpha-2 country code, such as `US`, an ISO 3166-2 subdivision code, such as `US-CA`, or an extension term for any other area, such as a metro list. A country covers every subdivision code it prefixes.",
      "pattern": "^([A-Z]{2}(-[A-Z0-9]{1,3})?|[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*:[A-Za-z0-9_-]+)$",
      "type": "string"
    },
    "HttpsUrl": {
      "description": "An absolute `https` URL, a location fetched over TLS.",
      "format": "uri",
      "pattern": "^https://.+$",
      "type": "string"
    },
