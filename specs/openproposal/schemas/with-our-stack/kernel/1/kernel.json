    "Instant": {
      "description": "A point in time, written as an RFC 3339 date-time in whole seconds that ends in `Z`, such as `2026-11-02T00:00:00Z`, so one instant has one written form.",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "IntegerFlag": {
      "description": "A yes or no written as an integer, `0` for no and `1` for yes, as AdCOM 1.0 and OpenRTB 2.6 write their flags, such as a placement's `instl`. A receiver reads it as a flag, never as a count, and a field that takes it keeps the integer its text writes.",
      "oneOf": [
        {
          "const": 0,
          "title": "No"
        },
        {
          "const": 1,
          "title": "Yes"
        }
      ],
      "type": "integer"
    },
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "$ref": "#/$defs/Instant",
          "description": "The last second, inclusive"
        },
        "start": {
          "$ref": "#/$defs/Instant",
          "description": "The first second"
        }
      },
      "required": [
        "end",
        "start"
      ],
      "type": "object"
    },
    "LineItemStatus": {
      "enum": [
        "draft",
        "published",
        "under_review",
        "agreed",
        "withdrawn",
        "expired",
        "sold_out"
      ],
      "type": "string"
    },
    "Measurer": {
      "anyOf": [
        {
          "$ref": "#/$defs/Side"
        },
        {
          "$ref": "#/$defs/RegistrableDomain"
        }
      ]
    },
    "NamespacedTerm": {
      "description": "A term outside a vocabulary's core list, written `<domain>:<term>`, where the domain is one its definer controls and a term is ASCII letters, digits, `_`, and `-`, such as `examplepub.example:podcast-host-read`.",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*:[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "Party": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "$ref": "#/$defs/RegistrableDomain",
          "description": "The party's domain"
        },
        "legal_name": {
          "description": "The party's legal name. A `registry_id` entry that applies can attest it; the value alone attests nothing",
          "type": "string"
        },
        "registry_id": {
          "description": "An IAB Tech Lab Agent Registry reference for the entity controlling `domain`",
          "type": "string"
        }
      },
      "required": [
        "domain"
      ],
      "type": "object"
    },
    "PreemptionRemedy": {
      "anyOf": [
        {
          "enum": [
            "makegood",
            "credit",
            "none"
          ],
          "type": "string"
        },
        {
          "$ref": "#/$defs/NamespacedTerm"
        }
      ]
    },
    "ProposalStatus": {
      "enum": [
        "draft",
        "published",
        "under_review",
        "agreed",
        "withdrawn",
        "expired"
      ],
      "type": "string"
    },
    "RegistrableDomain": {
      "description": "A domain that is the registrable domain of the Public Suffix List, taken over the whole list, its PRIVATE section included, written as a domain is, such as `examplepub.example`. It names a business.",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$",
      "type": "string"
    },
    "SafeInteger": {
      "description": "A whole number that every JSON implementation reads exactly, from −(2^53 − 1) to 2^53 − 1, for a row the text types as Integer and gives no other range; the field that holds it says what it counts.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "SeatRef": {
      "additionalProperties": false,
      "properties": {
        "dsp": {
          "$ref": "#/$defs/RegistrableDomain",
          "description": "The DSP's primary domain"
        },
        "ids": {
          "description": "The ids the DSP issues, the same values OpenRTB 2.6 carries in `Deal.wseat`",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "dsp"
      ],
      "type": "object"
    },
    "Side": {
      "enum": [
        "buyer",
        "seller"
      ],
      "type": "string"
    },
    "TaxonomyCodes": {
      "additionalProperties": false,
      "properties": {
        "ids": {
          "description": "Ids in that taxonomy",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "taxonomy": {
          "$ref": "#/$defs/SafeInteger",
          "description": "A value from the list the field names"
        }
      },
      "required": [
        "ids",
        "taxonomy"
      ],
      "type": "object"
    },
    "TimeOfDay": {
      "description": "A civil time of day, written `HH:MM` from `00:00` to `24:00`, read on the line item's clock. `24:00` is the end of the day, so it ends a window and never starts one.",
      "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$",
      "type": "string"
    },
    "TimeUnit": {
      "enum": [
        "hour",
        "day",
        "week",
        "month",
        "flight"
      ],
      "type": "string"
    },
    "TimeZone": {
      "description": "The clock a line item's daypart and frequency cap period are read on, a zone name of the IANA time zone database, such as `America/New_York` or `UTC`, or `viewer_local`, the clock where the ad renders. A zone name follows the zone's daylight saving rules, which a fixed offset doesn't.",
      "pattern": "^(viewer_local|[A-Z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*)$",
      "type": "string"
    },
    "TransactionMechanism": {
      "enum": [
        "direct_io",
        "programmatic_guaranteed",
        "preferred_deal",
        "private_auction"
      ],
      "type": "string"
    },
    "Url": {
      "description": "An absolute `http` or `https` URL, as RFC 3986 writes one, that a client can fetch.",
      "format": "uri",
      "pattern": "^https?://.+$",
      "type": "string"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "line_item_id": {
          "description": "A line item in that version",
          "type": "string"
        },
        "proposal_id": {
          "description": "The proposal",
          "type": "string"
        },
        "seller_domain": {
          "$ref": "#/$defs/RegistrableDomain",
          "description": "The proposal's `seller.domain`"
        },
        "version": {
          "$ref": "#/$defs/SafeInteger",
          "description": "The proposal's `version`"
        }
      },
      "required": [
        "proposal_id",
        "version"
      ],
      "type": "object"
    }
  },
  "$id": "https://openproposal.noetis.dev/schemas/with-our-stack/kernel/1/kernel.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The OpenProposal kernel: the primitives, the value objects and the parts that constructor copies share, and the kernel vocabularies, from § 2.2, § 3, § 3.1, § 3.2, § 2.4, § 2.5, and § 5.2.5.",
  "title": "kernel"
}
