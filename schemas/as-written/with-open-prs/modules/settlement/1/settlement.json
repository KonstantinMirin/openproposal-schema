          "$ref": "../../../kernel/1/kernel.json#/$defs/NamespacedTerm"
        }
      ]
    },
    "ExternalReferencesEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/ExternalId"
        },
        "namespace": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/ExternalId"
        },
        "role": {
          "$ref": "#/$defs/ExternalReferenceRole"
        },
        "system": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/ExternalId"
        }
      },
      "type": "object"
    }
