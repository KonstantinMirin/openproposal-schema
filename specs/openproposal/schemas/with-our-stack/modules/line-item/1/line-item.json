{
  "$defs": {
    "AvailabilityRead": {
      "additionalProperties": false,
      "properties": {
        "activation_route": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesSelectable",
          "description": "The line item's `activation_route`, projected to `selected[]`."
        },
        "audiences": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesAudienceSelectable",
          "description": "The line item's `audiences`, projected to `selected[]`, `excluded[]`, and `combine.selected[]`."
        },
        "break_position": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesSelectable",
          "description": "The line item's `break_position`, projected to `selected[]`."
        },
        "buyer_requirements": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesBuyerRequirements",
          "description": "The line item's `buyer_requirements`, projected to `seats` and `seat_owner`."
        },
        "cancellation_policy": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesSelectable",
          "description": "The line item's `cancellation_policy`, projected to `selected[]`."
        },
        "controlling_measurement": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesSelectable",
          "description": "The line item's `controlling_measurement`, projected to `selected[]`."
        },
        "daypart": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesSettable",
          "description": "The line item's `daypart`, projected to `value`."
        },
        "device": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesDeviceBounds",
          "description": "The line item's `device`, projected to `value`."
        },
        "environments": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesSelectable",
          "description": "The line item's `environments`, projected to `selected[]`."
        },
        "exclusions": {
          "additionalProperties": {
            "$ref": "../../targeting/1/targeting.json#/$defs/ExclusionList"
          },
          "description": "The buyer's block lists, keyed by exclusion type. See below",
          "propertyNames": {
            "$ref": "../../targeting/1/targeting.json#/$defs/ExclusionType"
          },
          "type": "object"
        },
        "exclusivity": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesSelectable",
          "description": "The line item's `exclusivity`, projected to `selected[]`."
        },
        "flight": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Interval",
          "description": "The flight, as `commitment.flight` (§ 5.6.1)"
        },
        "formats": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesSelectable",
          "description": "The line item's `formats`, projected to `selected[]`."
        },
        "frequency_cap": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesFrequencyCap",
          "description": "The line item's `frequency_cap`, projected to `count.value`."
        },
        "geo": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesGeoBounds",
          "description": "The line item's `geo`, projected to `value`."
        },
        "markets": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesSelectable",
          "description": "The line item's `markets`, projected to `selected[]`."
        },
        "measurement_source": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesSelectable",
          "description": "The line item's `measurement_source`, projected to `selected[]`."
        },
        "offer": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/VersionRef",
          "description": "The line item and the `version` whose options the figures are computed against. `line_item_id` is REQUIRED here"
        },
        "pricing_id": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainString",
          "description": "The entry the buyer means to commit under, as `commitment.pricing_id`, so that the figure can count that entry's `unit` (§ 5.6.5)"
        },
        "production": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesSelectable",
          "description": "The line item's `production`, projected to `selected[]`."
        },
        "programs": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesSelectable",
          "description": "The line item's `programs`, projected to `selected[]`."
        },
        "properties": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesSelectable",
          "description": "The line item's `properties`, projected to `selected[]`."
        },
        "reporting": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesSelectable",
          "description": "The line item's `reporting`, projected to `selected[]`."
        },
        "shortfall_remedy": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesShortfallRemedy",
          "description": "The line item's `shortfall_remedy`, projected to `selected[]`."
        },
        "transaction_mechanism": {
          "$ref": "../../commercial/1/commercial.json#/$defs/BuyerWritesSelectable",
          "description": "The line item's `transaction_mechanism`, projected to `selected[]`."
        }
      },
      "required": [
        "flight",
        "offer"
      ],
      "type": "object"
    },
    "MediaChannel": {
      "anyOf": [
        {
          "enum": [
            "dooh",
            "audio",
            "ctv",
            "native",
            "video",
            "display"
          ],
          "type": "string"
        },
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/NamespacedTerm"
        }
      ]
    }
  },
  "$id": "https://openproposal.noetis.dev/schemas/with-our-stack/modules/line-item/1/line-item.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The OpenProposal `line-item` module: the vocabularies, objects, unions, and constructor copies of § 3.3, § 5, § 5.1, and § 5.1.1.",
  "title": "line-item"
}
