{
  "$defs": {
    "LineItemSummaryFormatsSelection": {
      "additionalProperties": false,
      "properties": {
        "included": {
          "description": "The options in the base rate, each named as `available[]` holds it: a string option by its value, and an object option by its `id`, the UUID the seller mints for it.",
          "items": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/FormatId"
          },
          "type": "array"
        }
      },
      "required": [
        "included"
      ],
      "type": "object"
    },
    "LineItemSummaryPricingEntry": {
      "additionalProperties": false,
      "properties": {
        "cost_method": {
          "$ref": "../../commercial/1/commercial.json#/$defs/CostMethod",
          "description": "CPM, CPC, flat, etc."
        },
        "currency": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/CurrencyCode",
          "description": "ISO-4217"
        },
        "gross_rate": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Amount",
          "description": "The list rate the buyer pays"
        }
      },
      "required": [
        "cost_method",
        "currency",
        "gross_rate"
      ],
      "type": "object"
    },
    "LineItemSummaryPropertiesOption": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Text"
        }
      },
      "type": "object"
    },
    "LineItemSummaryPropertiesOptionOrCatalogRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/LineItemSummaryPropertiesOption"
        },
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/CatalogReference"
        }
      ],
      "description": "A value given inline, or a reference to the seller's catalog entry that holds it, never both."
    },
    "LineItemSummaryPropertiesSelection": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "description": "The line item's `properties.available[]`, each entry projected to `name`.",
          "items": {
            "$ref": "#/$defs/LineItemSummaryPropertiesOptionOrCatalogRef"
          },
          "type": "array"
        }
      },
      "required": [
        "available"
      ],
      "type": "object"
    }
  },
  "$id": "https://openproposal.noetis.dev/schemas/modules/representation/1/representation.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The OpenProposal `representation` module: the vocabularies, objects, unions, and constructor copies of § 2.1.",
  "title": "representation"
}
