            "$ref": "../../../kernel/1/kernel.json#/$defs/ExternalId"
          },
          "type": "array"
        },
        "type": {
          "$ref": "#/$defs/AgreementType"
        },
        "valid_from": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Timestamp"
        },
        "valid_until": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Timestamp"
        }
      },
      "type": "object"
    },
    "AgreementType": {
      "enum": [
        "upfront",
        "annual",
        "master_services",
        "other"
      ],
      "type": "string"
    },
    "Billing": {
      "additionalProperties": false,
      "properties": {
        "billing_supplier_id": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/ExternalId"
        },
        "invoicing_party": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Text"
        },
        "payment_terms": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Text"
        },
        "supplier_id": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/ExternalId"
        }
      },
      "type": "object"
    },
    "ExternalReferenceRole": {
      "anyOf": [
        {
          "enum": [
