{
  "$defs": {
    "AcceptedExclusions": {
      "additionalProperties": false,
      "properties": {
        "types": {
          "additionalProperties": {
            "$ref": "#/$defs/ExclusionTerms"
          },
          "description": "The exclusion types the seller accepts (core terms above), and its terms for each",
          "propertyNames": {
            "$ref": "#/$defs/ExclusionType"
          },
          "type": "object"
        },
        "verification": {
          "description": "The third parties that can attest the seller enforced these lists",
          "items": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/RegistrableDomain"
          },
          "type": "array"
        }
      },
      "required": [
        "types"
      ],
      "type": "object"
    },
    "CountSettableRange": {
      "additionalProperties": false,
      "description": "The range form of a settable field. The buyer writes `value` between `min` and `max` inclusive, and `default` is in effect when `value` is absent.",
      "properties": {
        "default": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainInteger",
          "description": "In effect when `value` is absent, between the bounds."
        },
        "max": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainInteger",
          "description": "The upper bound."
        },
        "min": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainInteger",
          "description": "The lower bound."
        },
        "value": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainInteger",
          "description": "The buyer's value, between the bounds inclusive."
        }
      },
      "required": [
        "default"
      ],
      "type": "object"
    },
    "DaypartBounds": {
      "additionalProperties": false,
      "description": "A field the buyer sets within the entries the seller allows, `allowed[]`, by writing a `value` that narrows them; `default` is in effect when `value` is absent.",
      "properties": {
        "allowed": {
          "description": "The entries the buyer narrows within.",
          "items": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/ClockWindow"
          },
          "type": "array"
        },
        "default": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/ClockWindowNarrowing",
          "description": "In effect when `value` is absent."
        },
        "value": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/ClockWindowNarrowing",
          "description": "The buyer's value."
        }
      },
      "required": [
        "allowed",
        "default"
      ],
      "type": "object"
    },
    "DeviceBounds": {
      "additionalProperties": false,
      "description": "A field the buyer sets within the entries the seller allows, `allowed[]`, by writing a `value` that narrows them; `default` is in effect when `value` is absent.",
      "properties": {
        "allowed": {
          "description": "The entries the buyer narrows within.",
          "items": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/PlainInteger"
          },
          "type": "array"
        },
        "default": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainIntegerNarrowing",
          "description": "In effect when `value` is absent."
        },
        "value": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainIntegerNarrowing",
          "description": "The buyer's value."
        }
      },
      "required": [
        "allowed",
        "default"
      ],
      "type": "object"
    },
    "ExclusionEntry": {
      "anyOf": [
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainString"
        },
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/AppId"
        },
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/TaxonomyCodes"
        }
      ]
    },
    "ExclusionList": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ExclusionEntry"
          },
          "type": "array"
        },
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/DocumentRef"
        }
      ]
    },
    "ExclusionTerms": {
      "additionalProperties": false,
      "properties": {
        "enforcement": {
          "$ref": "#/$defs/ExclusionTermsEnforcement",
          "description": "`pre_serve` | `best_effort`"
        },
        "max_entries": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainInteger",
          "description": "The most entries of this type the seller accepts"
        }
      },
      "required": [
        "enforcement"
      ],
      "type": "object"
    },
    "ExclusionTermsEnforcement": {
      "enum": [
        "pre_serve",
        "best_effort"
      ],
      "type": "string"
    },
    "ExclusionType": {
      "anyOf": [
        {
          "enum": [
            "domains",
            "apps",
            "categories",
            "keywords"
          ],
          "type": "string"
        },
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/NamespacedTerm"
        }
      ]
    },
    "FrequencyCap": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "$ref": "#/$defs/CountSettableRange",
          "description": "The cap. The buyer's `value` is the count, and `period` and `per` stay the seller's"
        },
        "per": {
          "$ref": "#/$defs/FrequencyCapPer",
          "description": "Who is capped. It matters: CTV typically caps at household, audio at listener. Core terms: `device` | `household` | `listener` | `screen`"
        },
        "period": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/TimeUnit",
          "description": "The bucket the count runs over"
        }
      },
      "required": [
        "count",
        "per",
        "period"
      ],
      "type": "object"
    },
    "FrequencyCapPer": {
      "anyOf": [
        {
          "enum": [
            "device",
            "household",
            "listener",
            "screen"
          ],
          "type": "string"
        },
        {
          "$ref": "../../../kernel/1/kernel.json#/$defs/NamespacedTerm"
        }
      ]
    },
    "GeoBounds": {
      "additionalProperties": false,
      "description": "A field the buyer sets within the entries the seller allows, `allowed[]`, by writing a `value` that narrows them; `default` is in effect when `value` is absent.",
      "properties": {
        "allowed": {
          "description": "The entries the buyer narrows within.",
          "items": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/GeoCode"
          },
          "type": "array"
        },
        "default": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/GeoCodeNarrowing",
          "description": "In effect when `value` is absent."
        },
        "value": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/GeoCodeNarrowing",
          "description": "The buyer's value."
        }
      },
      "required": [
        "allowed",
        "default"
      ],
      "type": "object"
    },
    "MarketsSelection": {
      "additionalProperties": false,
      "description": "A field the buyer sets by choosing options from the set the seller declares. `included[]` names the options in the base rate, `selected[]` the buyer's choice, which replaces it, and `deltas` the price of each option outside `included[]`, each by option id.",
      "properties": {
        "available": {
          "items": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/GeoCode"
          },
          "type": "array"
        },
        "deltas": {
          "additionalProperties": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/Delta"
          },
          "description": "The price of an option outside `included[]`, keyed by option id. An option with no entry has no delta.",
          "propertyNames": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/PlainString"
          },
          "type": "object"
        },
        "included": {
          "description": "The options in the base rate, by option id.",
          "items": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/PlainString"
          },
          "type": "array"
        },
        "max_select": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainInteger",
          "description": "The most options that may be in effect."
        },
        "selected": {
          "description": "The buyer's choice, by option id. It is the complete set in effect and replaces `included[]`.",
          "items": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/PlainString"
          },
          "type": "array"
        }
      },
      "required": [
        "available",
        "included"
      ],
      "type": "object"
    }
  },
  "$id": "https://openproposal.noetis.dev/schemas/as-written/with-our-stack/modules/targeting/1/targeting.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The OpenProposal `targeting` module: the vocabularies, objects, unions, and constructor copies of § 5.5.",
  "title": "targeting"
}
