{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KonstantinMirin/openproposal-schema/drift/sources.schema.json",
  "title": "Drift sources",
  "description": "The artifacts a registry's drift report compares its code lists with (src/drift.ts): each artifact's upstream, commit, and pinned files, and which of its enums holds each list.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "lock", "sources", "lists"],
  "properties": {
    "format": { "const": 1 },
    "lock": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "The registry lock whose lists the report reads." },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "upstream", "commit", "clone", "reader", "folder", "tree", "license"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "upstream": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "commit": { "$ref": "#/$defs/sha" },
          "clone": { "$ref": "#/$defs/path", "description": "A clone, relative to the repository's root, which must agree with every pin where it is reachable." },
          "reader": { "enum": ["proto", "go"] },
          "folder": { "$ref": "#/$defs/path", "description": "The folder the reader reads; the snapshot holds all of it." },
          "tree": { "$ref": "#/$defs/sha", "description": "The folder's git tree SHA at the commit." },
          "license": { "$ref": "#/$defs/file" }
        }
      }
    },
    "lists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["list", "enums"],
        "properties": {
          "list": { "type": "string", "pattern": "^[a-z0-9_-]+$", "description": "The list's section ID in the registry's IR." },
          "enums": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "additionalProperties": { "oneOf": [{ "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$" }, { "type": "null" }] }
          }
        }
      }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$", "not": { "pattern": "(^|/)\\.\\.?(/|$)" } },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blob"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "blob": { "$ref": "#/$defs/sha" } }
    }
  }
}
