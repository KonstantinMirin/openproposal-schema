{
  "$defs": {
    "ChangeRequest": {
      "additionalProperties": false,
      "properties": {
        "accountid": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainString",
          "description": "The account of the advertiser and buyer that own the change, the same as the OpenDirect Order's. An OpenDirect 2.1 ChangeRequest requires it"
        },
        "actor": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Side",
          "description": "The side that wrote the entry"
        },
        "at": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Instant",
          "description": "When that side wrote it"
        },
        "baseline": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/VersionRef",
          "description": "The agreed line item the request is against, at the `version` of its agreed record (§ 4.1.2). `line_item_id` is REQUIRED here"
        },
        "cancellation": {
          "$ref": "../../commercial/1/commercial.json#/$defs/CancellationNotice",
          "description": "The notice, when the request is to cancel under the option in effect (§ 5.6.6)"
        },
        "comments": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainString",
          "description": "Why the change is requested. Free text"
        },
        "contacts": {
          "description": "Contacts for this change, in addition to the buyer's and the advertiser's, one per contact type. As OpenDirect 2.1 Contact",
          "items": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/OpenObject"
          },
          "type": "array"
        },
        "ext": {
          "additionalProperties": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/OpenObject"
          },
          "description": "See Extensions (§ 2.5)",
          "propertyNames": {
            "$ref": "../../../kernel/1/kernel.json#/$defs/Domain"
          },
          "type": "object"
        },
        "id": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainString",
          "description": "Opaque identifier of the change request"
        },
        "lineid": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainString",
          "description": "The Line in that Order, for a change at line level"
        },
        "orderid": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainString",
          "description": "The order the change is requested for: the id in the `order` entry"
        },
        "providerdata": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/OpenObject",
          "description": "Structured references a buyer uses to identify its order in the seller's system"
        },
        "requesterid": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainString",
          "description": "The organization that requests the change: usually the agency, or the publisher. An OpenDirect 2.1 ChangeRequest requires it"
        },
        "status": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/ApprovalStatus",
          "description": "The outcome of the request"
        }
      },
      "required": [
        "actor",
        "at",
        "baseline",
        "id"
      ],
      "type": "object"
    },
    "HistoryEntry": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/HistoryEntryAction",
          "description": "`published` | `requested` | `granted` | `countered` | `declined` | `withdrawn`. § 4.3.1 says which interaction writes each"
        },
        "actor": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Side",
          "description": "The side that acted"
        },
        "at": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Instant",
          "description": "When the side acted"
        },
        "paths": {
          "description": "The fields the act changed or asked about. MAY be empty",
          "items": {
            "$ref": "#/$defs/HistoryPath"
          },
          "type": "array"
        },
        "version": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainInteger",
          "description": "The version the act created or refers to (§ 4.1.3)"
        }
      },
      "required": [
        "action",
        "actor",
        "at",
        "paths",
        "version"
      ],
      "type": "object"
    },
    "HistoryEntryAction": {
      "enum": [
        "published",
        "requested",
        "granted",
        "countered",
        "declined",
        "withdrawn"
      ],
      "type": "string"
    },
    "HistoryPath": {
      "additionalProperties": false,
      "properties": {
        "line_item_id": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainString",
          "description": "The line item. When absent, `pointer` is into the proposal"
        },
        "pointer": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/FieldPointer",
          "description": "Into that line item or the proposal"
        },
        "requested_value": {
          "$ref": "#/$defs/RequestedValue",
          "description": "On a `requested` entry, the value the buyer asked for. On a `declined` entry, or a buyer's `withdrawn` entry, the value of the `request` it ended. Absent on every other entry"
        }
      },
      "required": [
        "pointer"
      ],
      "type": "object"
    },
    "MinCommitment": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainNumber",
          "description": "The figure committed: an `Amount` when `basis` is `spend`, otherwise a whole number of the entry's units (§ 5.6.5)"
        },
        "basis": {
          "$ref": "../../commercial/1/commercial.json#/$defs/CommitmentAmountBasis",
          "description": "`spend` | `units`"
        },
        "line_item_id": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainString",
          "description": "A line item in the package's `line_items[]`"
        }
      },
      "required": [
        "amount",
        "basis",
        "line_item_id"
      ],
      "type": "object"
    },
    "ProposalType": {
      "enum": [
        "standard",
        "custom"
      ],
      "type": "string"
    },
    "RequestedUnitBoundsRange": {
      "additionalProperties": false,
      "description": "A range of values from `min` to `max`, with at least one bound, such as the time an ad stays in the content the seller distributes.",
      "minProperties": 1,
      "properties": {
        "max": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainInteger"
        },
        "min": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/PlainInteger"
        }
      },
      "type": "object"
    },
    "RequestedValue": {
      "additionalProperties": false,
      "properties": {
        "commitment_bounds": {
          "$ref": "../../commercial/1/commercial.json#/$defs/CommitmentBounds",
          "description": "The line item's `commitment_bounds`"
        },
        "committed_metrics": {
          "description": "The line item's `committed_metrics[]`",
          "items": {
            "$ref": "../../guarantees/1/guarantees.json#/$defs/CommittedMetric"
          },
          "type": "array"
        },
        "list_rate": {
          "$ref": "../../../kernel/1/kernel.json#/$defs/Amount",
          "description": "A `pricing[].list_rate`"
        },
        "materials_due": {
          "$ref": "../../creative/1/creative.json#/$defs/MaterialsDue",
          "description": "The line item's `materials_due`"
        },
        "unit_bounds": {
          "$ref": "#/$defs/RequestedUnitBoundsRange",
          "description": "A `pricing[].unit_bounds`"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://openproposal.noetis.dev/schemas/with-our-stack/modules/proposal/1/proposal.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The OpenProposal `proposal` module: the vocabularies, objects, unions, and constructor copies of § 4, § 4.1, § 4.2, § 4.1.1, § 4.1.3, § 4.1.4, § 4.3, § 4.3.1, § 4.3.2, § 4.3.3, § 4.3.4, and § 4.4.",
  "title": "proposal"
}
